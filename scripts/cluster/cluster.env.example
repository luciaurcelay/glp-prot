# Copy this file to scripts/cluster/cluster.env (gitignored) and fill in
# GLP_DATA_ROOT before using anything under scripts/cluster/. Not committed
# because the path is specific to your allocation on MN5.
#
# GLP_DATA_ROOT holds the venv, the HF cache, activation stores, and
# runs/ (checkpoints + metrics + figures). Keep it OFF $HOME — the gpfs_home
# quota is 80 GB and was at 74 GB used as of 2026-07-27. Put this on cluster
# storage instead, e.g.:
#   /gpfs/scratch/bsc70/bsc070332/glp-prot-data      (more free space, but
#                                                      scratch is typically
#                                                      purged periodically)
#   /gpfs/projects/bsc70/<some-subdir>/glp-prot-data  (more durable, but the
#                                                      bsc70 group quota had
#                                                      only ~860 GB free)
# Neither existed for this user as of 2026-07-27 — create whichever you pick
# (env_mn5.sh will `mkdir -p` it).
export GLP_DATA_ROOT=
