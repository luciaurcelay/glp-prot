*.safetensors
*.npz
*.gz
# only the repo-root data dir (NOT the glp_plm/data source package)
/data/

# Cluster (MN5) launcher config — path is per-user, not shared (scripts/cluster/README.md)
scripts/cluster/cluster.env
*.out
*.err

# Reference PDFs (kept locally as ground truth, not tracked — 34 MB)
docs/papers/

