# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Runs / artifacts / data (never commit large blobs) — except each run's
# write-up (run_summary.md), which we do want in git history.
# Needs the 4-line form below, not a single `runs/` rule: gitignore can't
# re-include a file whose parent directory is itself excluded, so each level
# under runs/ has to be excluded-then-reincluded explicitly.
# NOTE: when runs/ is a symlink to cluster storage (env_mn5.sh), `git status`/
# `git add -A` won't auto-discover files through it (git doesn't follow
# symlinks while walking the working tree) — add explicitly instead:
#   git add runs/<run>/run_summary.md
runs/*
!runs/*/
runs/*/*
!runs/*/run_summary.md
*.pt
*.safetensors
*.npz
*.gz
# only the repo-root data dir (NOT the glp_plm/data source package)
/data/

# Cluster (MN5) launcher config — path is per-user, not shared (scripts/cluster/README.md)
scripts/cluster/cluster.env

# Personal local<->MN5 git sync helper — hardcodes one user's paths + SSH alias, not shared
scripts/sync-to-mn5.sh
*.out
*.err

# OS
.DS_Store
